{
  "name": "drmove",
  "version": "0.1.0",
  "private": true,
  "main": "build/electron.js",
  "homepage": ".",
  "description": "Aplicação DrMove para controle de esteira ergométrica via porta serial para Windows",
  "author": "Diego Pedroso",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "d3": "^7.9.0",
    "electron-is-dev": "^3.0.1",
    "motion": "^12.7.3",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "react-scripts": "5.0.1",
    "serialport": "^12.0.0",
    "typescript": "^4.9.5",
    "use-sound": "^5.0.0",
    "wait-on": "^8.0.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "electron": "^35.1.3",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:all": "npm run build && electron-builder --win --mac --linux",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron:prod": "npm run build && cross-env NODE_ENV=production electron ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.drmove.control",
    "productName": "DrMove",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/logo512.png",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/logo512.png",
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/logo512.png",
      "category": "Science"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeader": "build/logo512.png",
      "installerHeaderIcon": "build/logo512.png",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "asarUnpack": [
      "build/static/media/**/*",
      "node_modules/@serialport"
    ]
  }
}
